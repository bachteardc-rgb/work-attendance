# Prisma Database URL (PostgreSQL 전용)
# prisma/schema.prisma의 datasource가 postgresql이므로 SQLite(file:...) URL은 동작하지 않습니다.
# sslmode는 반드시 verify-full로 지정하세요. require/prefer/verify-ca를 쓰면 pg 드라이버가
# deprecation 경고를 띄우고, pg v9부터는 인증서 검증이 조용히 비활성화됩니다.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full&channel_binding=require"

# NextAuth Configuration
# 배포할 서버의 실제 도메인 주소로 변경 필수 (예: https://attendance.example.com)
NEXTAUTH_URL="http://localhost:3000"
# 무작위의 긴 문자열 (JWT 암호화에 사용됨), $ openssl rand -base64 32 명령어로 생성 권장
NEXTAUTH_SECRET="여기에_openssl_rand_base64_32_결과를_붙여넣으세요"

# Google OAuth Credentials (선택사항, 구글 로그인을 사용하는 경우)
# Google Cloud Console에서 생성한 클라이언트 ID와 Secret 입력
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# 데모 모드 (선택)
# "true" 로 두면 로그인 화면과 앱 상단에 "데모 환경" 안내 배너가 표시됩니다.
# 실제 운영 배포에서는 설정하지 마세요.
NEXT_PUBLIC_DEMO_MODE="false"
