generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// NextAuth.js Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // 근태관리 앱 고유 필드 (Employees)
  department       String?
  baseSchedule     String    @default("09:00-18:00")
  annualLeaveTotal Float     @default(15.0)
  annualLeaveUsed  Float     @default(0.0)
  role             String    @default("USER") // USER, ADMIN

  accounts            Account[]
  sessions            Session[]
  leaveRequests       LeaveRequest[]
  overtimeRequests    OvertimeRequest[]
  scheduleAdjustments ScheduleAdjustment[]
  leaveQuotas         LeaveQuota[]
  educationRequests   EducationRequest[]
  businessTrips       BusinessTripRequest[]
  overtimeQuotas      OvertimeQuota[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 비즈니스 로직 Models

model LeaveType {
  id          String   @id @default(cuid())
  code        String   @unique // ANNUAL, SICK, OFFICIAL, FAMILY_CARE, COMPENSATORY 등
  name        String   // 연차, 병가, 공가, 가족돌봄휴가, 대체휴가 등
  isPaid      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
}

model LeaveQuota {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int      // 예: 2026
  leaveType String   // ANNUAL, SICK, OFFICIAL, FAMILY_CARE, COMPENSATORY 등
  totalDays Float    // 총 부여 일수
  usedDays  Float    @default(0.0) // 사용 일수

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, leaveType])
}

model LeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // ANNUAL, HALF_AM, HALF_PM, SICK, OFFICIAL, FAMILY_CARE, COMPENSATORY 등
  startDate DateTime
  endDate   DateTime
  daysUsed  Float
  reason    String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OvertimeRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  startTime   String   // 예: "18:00"
  endTime     String   // 예: "21:30"
  totalHours  Float    // 예: 3.5
  description String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScheduleAdjustment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applyDate     DateTime
  originalTime  String   // 예: "09:00-18:00"
  requestedTime String   // 예: "10:00-19:00"
  reason        String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Force prisma generate on Vercel by modifying schema

// 교육신청 / 교육결과
// 교육결과는 신청이 승인된 뒤 신청자가 result* 필드를 채워 제출합니다 (1신청 : 1결과).
model EducationRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   // 교육명
  institution String?  // 교육기관
  startDate   DateTime
  endDate     DateTime
  cost        Float    @default(0.0) // 교육비
  purpose     String?  // 교육 목적 및 신청 사유
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED

  // 교육결과 (교육 종료 후 신청자가 제출)
  resultContent     String? // 교육 내용 및 결과 보고
  resultSubmittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 출장신청 / 출장결과
// 출장결과는 신청이 승인된 뒤 신청자가 result* 필드를 채워 제출합니다 (1신청 : 1결과).
model BusinessTripRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String   // 출장지
  purpose     String?  // 출장 목적
  startDate   DateTime
  endDate     DateTime
  companions  String?  // 동행자
  cost        Float    @default(0.0) // 출장비
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED

  // 출장결과 (출장 종료 후 신청자가 제출)
  resultContent     String? // 출장 내용 및 결과 보고
  resultSubmittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 직원별 시간외근무 부여시간 (관리자가 연도 단위로 일괄 부여)
// monthlyHours 는 "매월" 사용할 수 있는 시간이며, 해당 연도의 각 달에 동일하게 적용됩니다.
model OvertimeQuota {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year         Int
  monthlyHours Float    @default(0.0) // 월 부여시간

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
}
